    <string name="import_instructions_title">How to export data from Huawei Health</string>
    <string name="import_step1_title">Open Huawei Health</string>
    <string name="import_step1_body">Launch the Huawei Health app on your device.</string>
    <string name="import_step2_title">Go to your profile</string>
    <string name="import_step2_body">Tap Me (Profile) in the bottom right corner.</string>
    <string name="import_step3_title">Find Privacy settings</string>
    <string name="import_step3_body">Scroll down and open Privacy → Export health data.</string>
    <string name="import_step4_title">Export the archive</string>
    <string name="import_step4_body">Tap Export. Huawei Health will create a ZIP file and offer to save or share it.</string>
    <string name="import_step5_title">Select the file here</string>
    <string name="import_step5_body">Return to BitLut and tap the button below. Find the downloaded ZIP archive and open it.</string>
