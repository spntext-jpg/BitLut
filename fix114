python3 - <<'PY'
from pathlib import Path
import re

# Version
p = Path("app/build.gradle.kts")
s = p.read_text()
s = re.sub(r'versionCode\s*=\s*\d+', 'versionCode = 16', s)
s = re.sub(r'versionName\s*=\s*"[^"]+"', 'versionName = "1.1.5"', s)
p.write_text(s)

# Huawei scopes: match requested Health Kit application, no Heart Rate
p = Path("app/src/main/java/com/openhealth/sync/data/HuaweiHealthManager.kt")
s = p.read_text()
s = re.sub(
    r'private val scopes = arrayOf\([\s\S]*?\)',
    '''private val scopes = arrayOf(
        Scopes.HEALTHKIT_STEP_READ,
        Scopes.HEALTHKIT_DISTANCE_READ,
        Scopes.HEALTHKIT_ACTIVITY_READ,
        Scopes.HEALTHKIT_ACTIVITY_RECORD_READ,
        Scopes.HEALTHKIT_HISTORYDATA_OPEN_WEEK
    )''',
    s,
    count=1
)
s = s.replace(
    'val heartRates = readHeartRates(startTimeMs, endTimeMs)',
    'val heartRates = emptyList<HeartRateData>()'
)
p.write_text(s)

# Remove possible second shortcut alias
p = Path("app/src/main/AndroidManifest.xml")
s = p.read_text()
s = re.sub(
    r'\n\s*<activity-alias\s+android:name="\.HealthConnectRationaleActivity"[\s\S]*?</activity-alias>\s*',
    '\n',
    s
)
p.write_text(s)

# Google Health Connect permissions: steps + distance + exercise, no heart rate
p = Path("app/src/main/java/com/openhealth/sync/data/GoogleHealthManager.kt")
s = p.read_text()
for imp in [
    'import androidx.health.connect.client.records.HeartRateRecord\n',
]:
    s = s.replace(imp, '')

needed_imports = [
    'import androidx.health.connect.client.records.DistanceRecord',
    'import androidx.health.connect.client.records.ExerciseSessionRecord',
]
for imp in needed_imports:
    if imp not in s:
        lines = s.splitlines()
        insert_at = max(i for i, line in enumerate(lines) if line.startswith("import ")) + 1
        lines.insert(insert_at, imp)
        s = "\n".join(lines) + "\n"

s = re.sub(r'\s*HealthPermission\.getWritePermission\(HeartRateRecord::class\),?\n', '\n', s)

for perm in [
    'HealthPermission.getWritePermission(DistanceRecord::class)',
    'HealthPermission.getWritePermission(ExerciseSessionRecord::class)',
]:
    if perm not in s:
        s = s.replace(
            'HealthPermission.getWritePermission(StepsRecord::class)',
            f'HealthPermission.getWritePermission(StepsRecord::class),\n        {perm}',
            1
        )

p.write_text(s)

# Manifest: remove heart rate, add distance/exercise
p = Path("app/src/main/AndroidManifest.xml")
s = p.read_text()
for line in [
    '    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />\n',
    '    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />\n',
]:
    s = s.replace(line, '')

for perm in [
    '<uses-permission android:name="android.permission.health.WRITE_DISTANCE" />',
    '<uses-permission android:name="android.permission.health.WRITE_EXERCISE" />',
]:
    if perm not in s:
        pos = s.find(">") + 1
        s = s[:pos] + "\n    " + perm + s[pos:]

p.write_text(s)
PY