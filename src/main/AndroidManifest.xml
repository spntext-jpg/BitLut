<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/滿足/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешение на работу в фоне -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenHealthSync"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Обязательный фильтр для Health Connect: показывает пользователю наши намерения -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Специфический интент-фильтр для интеграции в системные настройки здоровья Android -->
        <activity-alias
            android:name="ViewPermissionRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
<!-- ... Предыдущий код MainActivity остается без изменений ... -->

        <!-- Обработчик OAuth Редиректа Huawei -->
        <activity
            android:name=".HuaweiCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="OpenHealth OAuth Callback">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Перехватываем строго наш Redirect URL -->
                <data android:scheme="https" android:host="com.openhealth.sync" android:path="/oauth_callback" />
            </intent-filter>
        </activity>

    </application>
</manifest>